<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="16dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CallShield"
        android:textColor="@color/accent"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="8dp" />

    <!-- Number Input Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:padding="16dp"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/numberInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dial_pad_hint"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="28sp"
            android:fontFamily="sans-serif-medium"
            android:inputType="phone"
            android:background="@null"
            android:padding="8dp" />

        <TextView
            android:id="@+id/threatBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            style="@style/ThreatBadge"
            tools:text="⚠️ SCAM — Insurance Fraud"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/carrierInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            style="@style/CarrierInfo"
            tools:text="Jio · Mumbai · Maharashtra"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- Dial Pad Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="3"
        android:rowCount="4">

        <Button
            android:id="@+id/btn1"
            style="@style/DialPadButton"
            android:text="1" />

        <Button
            android:id="@+id/btn2"
            style="@style/DialPadButton"
            android:text="2" />
        <!-- Subtext ABC not shown on dial pad -->

        <Button
            android:id="@+id/btn3"
            style="@style/DialPadButton"
            android:text="3" />

        <Button
            android:id="@+id/btn4"
            style="@style/DialPadButton"
            android:text="4" />

        <Button
            android:id="@+id/btn5"
            style="@style/DialPadButton"
            android:text="5" />

        <Button
            android:id="@+id/btn6"
            style="@style/DialPadButton"
            android:text="6" />

        <Button
            android:id="@+id/btn7"
            style="@style/DialPadButton"
            android:text="7" />

        <Button
            android:id="@+id/btn8"
            style="@style/DialPadButton"
            android:text="8" />

        <Button
            android:id="@+id/btn9"
            style="@style/DialPadButton"
            android:text="9" />

        <Button
            android:id="@+id/btnStar"
            style="@style/DialPadButton"
            android:text="*" />

        <Button
            android:id="@+id/btn0"
            style="@style/DialPadButton"
            android:text="0" />

        <Button
            android:id="@+id/btnHash"
            style="@style/DialPadButton"
            android:text="#" />
    </GridLayout>

    <!-- Bottom Row: Backspace + Call -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp">

        <Button
            android:id="@+id/btnBackspace"
            style="@style/DialPadButton"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:text="⌫"
            android:textSize="20sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/callButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/call_button_background"
            android:text="📞"
            android:textSize="28sp"
            android:stateListAnimator="@null"
            android:elevation="4dp" />

    </LinearLayout>

    <!-- Recent Lookups -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/recent_lookups"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recentRecycler"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@color/surface"
        android:padding="4dp" />

</LinearLayout>
