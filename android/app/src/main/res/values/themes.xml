<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base dark green theme matching the web app -->
    <style name="Theme.CallShield" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnPrimary">@color/on_primary</item>
    </style>

    <!-- Dial pad button style -->
    <style name="DialPadButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/dial_pad_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Threat badge text style -->
    <style name="ThreatBadge" parent="TextAppearance.AppCompat.Body1">
        <item name="android:padding">8dp</item>
        <item name="android:background">@drawable/threat_badge_background</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Carrier info text -->
    <style name="CarrierInfo" parent="TextAppearance.AppCompat.Body2">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>
</resources>
