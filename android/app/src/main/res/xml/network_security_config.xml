<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 
        CallShield India — Network Security Policy
        
        HTTPS-only to the Vercel backend. No cleartext traffic.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">callshield-india-olive.vercel.app</domain>
        <domain includeSubdomains="true">vercel.app</domain>
    </domain-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
